<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.0"?>
<plugin> 
   <extension
         point="org.eclipse.ui.editors">
      <editor
            class="at.laplace.tmpxplugin.editor.ASMEditor"
            contributorClass="org.eclipse.ui.editors.text.TextEditorActionContributor"
            default="true"
            extensions="asm, inc, s, sym"
            icon="icons/16/asm.gif"
            id="TMPxPlugin.editor"
            name="%editor.name">
              <contentTypeBinding contentTypeId="at.laplace.tmpxplugin.asm.contenttypeMod" />
            </editor>
   </extension>
   <extension
         point="org.eclipse.ui.preferencePages">
      <page
            class="at.laplace.tmpxplugin.ui.PreferencesGeneral"
            id="at.laplace.tmpxplugin.preferences.general"
            name="%preferences.general.name"/>
      <page
            category="at.laplace.tmpxplugin.preferences.general"
            class="at.laplace.tmpxplugin.ui.PreferencesCompiler"
            id="at.laplace.tmpxplugin.preferences.compiler"
            name="%preferences.compiler.name"/>
      <page
            category="at.laplace.tmpxplugin.preferences.general"
            class="at.laplace.tmpxplugin.ui.PreferencesDebugger"
            id="at.laplace.tmpxplugin.preferences.debugger"
            name="%preferences.debugger.name"/>
	   <page
            category="at.laplace.tmpxplugin.preferences.general"
            class="at.laplace.tmpxplugin.ui.PreferencesTemplates"
            id="at.laplace.tmpxplugin.preferences.templates"
            name="%preferences.templates.name"/>
   </extension>
   <extension
         id="nature"
         name="TMPx Assembler Nature"
         point="org.eclipse.core.resources.natures">
      <runtime>
         <run class="at.laplace.tmpxplugin.TmpNature"/>
      </runtime>
   </extension>
   <extension
         point="org.eclipse.ui.ide.projectNatureImages">
      <image
            icon="icons/8/asm.gif"
            id="at.laplace.tmpxplugin.nature.image"
            natureId="at.laplace.tmpxplugin.nature"/>
   </extension>
   <extension
         id="builder"
         name="Kick Assembler Builder"
         point="org.eclipse.core.resources.builders">
      <builder
            hasNature="false"
            isConfigurable="false">
         <run class="at.laplace.tmpxplugin.TmpBuilder"/>
      </builder>
   </extension>
   <extension
   		 point="org.eclipse.ui.newWizards">
      <wizard
            category="at.laplace.tmpxplugin.new.category"
            class="at.laplace.tmpxplugin.ui.WizardNewProject"
            hasPages="true"
            icon="icons/16/new_asm_project.gif"
            id="at.laplace.tmpxplugin.new.project"
            name="%new.project.name"
            project="true">
         <description>
            %new.project.description
         </description>
      </wizard>
      <wizard
            canFinishEarly="true"
            category="at.laplace.tmpxplugin.new.category"
            class="at.laplace.tmpxplugin.ui.WizardNewFile"
            hasPages="true"
            icon="icons/16/new_asm_file.gif"
            id="at.laplace.tmpxplugin.new.file"
            name="%new.file.name"
            project="false">
         <description>
            %new.file.description
         </description>
      </wizard>
      <category
            id="at.laplace.tmpxplugin.new.category"
            name="%new.category"/>
   </extension>
   <extension
         point="org.eclipse.ui.actionSets">
      <actionSet
            id="at.laplace.tmpxplugin.actionSet.helper"
            label="%actionset.asmhelper"
            visible="true">
         <action
               class="at.laplace.tmpxplugin.ui.AsciiAction"
               disabledIcon="icons/16/ascii_on.gif"
               hoverIcon="icons/16/ascii_on.gif"
               icon="icons/16/ascii_on.gif"
               id="at.laplace.tmpxplugin.ascii.wizard.RunWizardAction"
               label="%ascii.dialog.action.name"
               toolbarPath="toolbar.asm"
               tooltip="%ascii.dialog.action.tooltip" />
      </actionSet>
   </extension>
   <extension
         point="org.eclipse.ui.commands">
      <command
            categoryId="org.eclipse.ui.category.edit"
            id="at.laplace.tmpxplugin.toggle.comment"
            name="%command.toggle.comment.name"/>
      <command
            categoryId="org.eclipse.ui.category.edit"
            id="at.laplace.tmpxplugin.trigger.build"
            name="Trigger Build"/>
   </extension>
   <extension
         point="org.eclipse.ui.bindings">
      <key
            commandId="at.laplace.tmpxplugin.toggle.comment"
            contextId="at.laplace.tmpxplugin.editorScope"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="M1+M2+C"/>
      <key
            commandId="at.laplace.tmpxplugin.toggle.comment"
            contextId="at.laplace.tmpxplugin.editorScope"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="M1+7"/>
      <key
            commandId="at.laplace.tmpxplugin.toggle.comment"
            contextId="at.laplace.tmpxplugin.editorScope"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="M1+/"/>
       <key
            commandId="at.laplace.tmpxplugin.trigger.build"
            contextId="at.laplace.tmpxplugin.editorScope"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
      	    sequence="M3+F11"/>
   </extension>
   <extension
         point="org.eclipse.ui.contexts">
      <context
            id="at.laplace.tmpxplugin.editorScope"
            name="%context.scope"
            parentId="org.eclipse.ui.textEditorScope"/>
   </extension>
   <extension
         point="org.eclipse.debug.ui.launchShortcuts">
      <shortcut
            class="at.laplace.tmpxplugin.launch.ASMLaunchShortcut"
            icon="icons/16/launch.gif"
            id="at.laplace.tmpxplugin.shortcut"
            label="%launcher.name"
            modes="run, debug">
         <contextualLaunch>
            <contextLabel
                  label="%launcher.run.name"
                  mode="run"/>
            <contextLabel
                  label="%launcher.debug.name"
                  mode="debug"/>
            <enablement>
               <with variable="selection">
                  <count value="1">
                  </count>	
                  <iterate>
                     <or>
                        <test property="org.eclipse.debug.ui.matchesPattern" value="*.prg"/>
                        <instanceof value="org.eclipse.core.resources.IFile"/>
                     </or>
                  </iterate>
               </with>
            </enablement>
         </contextualLaunch>
      </shortcut>
   </extension>
   <extension
         point="org.eclipse.debug.core.launchConfigurationTypes">
      <launchConfigurationType
            delegate="at.laplace.tmpxplugin.launch.ASMLauncher"
            id="at.laplace.tmpxplugin.launch"
            modes="run, debug"
            name="%launcher.config.name"
            public="true"/>
   </extension>
   <extension
         point="org.eclipse.debug.ui.launchConfigurationTabGroups">
      <launchConfigurationTabGroup
            class="at.laplace.tmpxplugin.launch.ASMLaunchTabGroup"
            id="at.laplace.tmpxplugin.launch.tabs"
            type="at.laplace.tmpxplugin.launch"/>
   </extension>
   <extension
         point="org.eclipse.debug.ui.launchConfigurationTypeImages">
      <launchConfigurationTypeImage
            configTypeID="at.laplace.tmpxplugin.launch"
            icon="icons/16/launch.gif"
            id="at.laplace.tmpxplugin.launch.image"/>
   </extension>
   <extension
         point="org.eclipse.help.toc">
      <toc
            file="doc/toc.xml"
            primary="true"/>
   </extension>
   <extension
         point="org.eclipse.ui.popupMenus">
      <objectContribution
            id="at.laplace.tmpxplugin.contribution1"
            objectClass="org.eclipse.core.resources.IProject">
         <menu
               id="at.laplace.tmpxplugin.menu1"
               label="Build Path"
               path="edit">
            <separator
                  name="group1">
            </separator>
         </menu>
         <action
               class="at.laplace.tmpxplugin.popup.actions.BuildpathAction"
               enablesFor="1"
               id="at.laplace.tmpxplugin.newAction"
               label="Configure Build Path"
               menubarPath="at.laplace.tmpxplugin.menu1/group1">
         </action>
         <enablement>
	     <or>
	         <instanceof value="com.acme.navigator.ContainerObject"/>
	         <instanceof value="com.acme.navigator.RootObject"/>
	         <adapt type="org.eclipse.core.resources.IResource">
	             <test
	                   property="org.eclipse.core.resources.projectNature"
	                   value="at.laplace.tmpxplugin.nature">
	             </test>
	         </adapt>
	     </or>
	 </enablement>
	      </objectContribution>
   </extension>
   <extension
         point="org.eclipse.core.runtime.preferences" name="preferences">
         <scope name="project" class="org.eclipse.core.internal.resources.ProjectPreferences"/>
   </extension>
   <extension
         point="org.eclipse.ui.propertyPages">
         <page
            name="Build Path"
            nameFilter="*"
            class="at.laplace.tmpxplugin.ui.BuildPathPropertyPage"
            id="at.laplace.tmpxplugin.buildPathPropertyPage">
      		 <enabledWhen>
      		 <and>
             <instanceof
                  value="org.eclipse.core.resources.IProject">
             </instanceof>
              <adapt type="org.eclipse.core.resources.IResource">
	             <test
	                   property="org.eclipse.core.resources.projectNature"
	                   value="at.laplace.tmpxplugin.nature">
	             </test>
	         </adapt>
	         </and>
          </enabledWhen>
      	</page>
   </extension>
   <extension
         id="at.laplace.tmpxplugin.asm.contentType"
         point="org.eclipse.core.contenttype.contentTypes">
      <content-type
            id="at.laplace.tmpxplugin.asm.contenttypeMod"
            file-extensions="asm,inc,sym,s"
            base-type="org.eclipse.core.runtime.text"
            name="KickAssembler File"
            priority="high">
      </content-type>
   </extension>
</plugin>
